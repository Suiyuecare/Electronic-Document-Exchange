{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 180,
        "includeFiles": [
          "assets/fonts/LXGWWenKaiTC-Regular.ttf",
          "supabase/verification/production_cutover_checks.sql",
          "supabase/verification/migration_manifest.json"
        ]
      }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "entry-bootstrap.js", "use": "@vercel/static" },
    { "src": "pdfjs-bootstrap.mjs", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "vendor/pdfjs/pdf.min.mjs", "use": "@vercel/static" },
    { "src": "vendor/pdfjs/pdf.worker.min.mjs", "use": "@vercel/static" },
    { "src": "vendor/pdfjs/LICENSE", "use": "@vercel/static" },
    { "src": "assets/favicon-32.png", "use": "@vercel/static" },
    { "src": "assets/favicon-48.png", "use": "@vercel/static" },
    { "src": "assets/favicon-192.png", "use": "@vercel/static" },
    { "src": "assets/apple-touch-icon.png", "use": "@vercel/static" },
    { "src": "assets/suiyue-milk-favicon.png", "use": "@vercel/static" },
    { "src": "assets/fonts/LXGWWenKaiTC-Regular.woff2", "use": "@vercel/static" },
    { "src": "assets/fonts/LXGWWenKaiTC-OFL.txt", "use": "@vercel/static" }
  ],
  "crons": [
    {
      "path": "/api/cron/run-due",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/monitoring",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/fonts/LXGWWenKaiTC-Regular.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/fonts/LXGWWenKaiTC-Regular\\.woff2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
      },
      "continue": true
    },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
