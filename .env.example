# Local mode: SQLite. Production mode: Supabase PostgREST.
EDOC_DEPLOYMENT_ENV=development
EDOC_DB_MODE=sqlite
EDOC_LAUNCH_SCOPE=internal_official
# Finance is the sole company directory by default. Use manual_allowlist only
# as an emergency rollout restriction; future Finance companies then require ids.
EDOC_LAUNCH_COMPANY_MODE=finance_active
EDOC_LAUNCH_COMPANY_IDS=
EDOC_PDF_EDITOR_V2_COMPANY_MODE=finance_active
EDOC_PDF_EDITOR_V2_COMPANY_IDS=
EDOC_PUBLIC_BASE_URL=https://edoc.suiyuecare.com
EDOC_MONITORING_EXPECTED_CRON_MINUTES=1440
# Required before a Supabase restore drill can report success. The runner must
# restore Database + private Storage into a different isolated project and
# return row-count, object-hash, PDF-open, RTO/RPO and signed receipt evidence.
EDOC_RESTORE_DRILL_ENDPOINT=
EDOC_RESTORE_DRILL_TOKEN=
EDOC_RESTORE_DRILL_TIMEOUT_SECONDS=300
# Optional AI drafting. Server-side only; never expose this value in app.js or HTML.
OPENAI_API_KEY=replace-with-server-side-openai-key
OPENAI_MODEL=gpt-4.1-mini
# Production blocks demo/quick login by safe default. Keep this explicit in
# production for audit evidence; never enable EDOC_ALLOW_DEMO_ACCOUNTS there.
EDOC_DISABLE_DEMO_ACCOUNTS=false
# EDOC_ALLOW_DEMO_ACCOUNTS=false
MONITORING_WEBHOOK_URL=https://monitoring-webhook.example.com/suiyuecare-edoc
SENTRY_DSN=https://public@sentry.example.com/1

# Logging Portal SSO. Use the same value in login.suiyuecare.com
# PORTAL_HANDOFF_SIGNING_SECRET so EDOC can verify signed handoff tokens.
EDOC_PORTAL_HANDOFF_SECRET=replace-with-shared-portal-handoff-secret
EDOC_PORTAL_HANDOFF_MAX_AGE_SECONDS=600

# Server-to-server Finance authority snapshot. The browser must never receive
# this URL or secret; use a dedicated secret, not a Supabase service role key.
EDOC_FINANCE_BRIDGE_URL=https://finance.example.com/functions/v1/edoc-identity-snapshot
EDOC_FINANCE_BRIDGE_SECRET=replace-with-dedicated-finance-bridge-secret
EDOC_FINANCE_BRIDGE_TIMEOUT_SECONDS=3
EDOC_FINANCE_SESSION_REVALIDATE_SECONDS=60

# Electronic official document exchange gateway. Keep mock until the formal
# jAgent / file exchange / SOAP / HTTP API / SDK spec is provided.
EDOC_EXCHANGE_ENV=sandbox
EDOC_EXCHANGE_PROVIDER=mock
EDOC_EXCHANGE_MAX_RETRIES=3
EDOC_EXCHANGE_MOCK_SCENARIO=success
EDOC_EXCHANGE_MOCK_INBOUND_COUNT=1

# Set these on Vercel for production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional public key if you later add browser-side Supabase clients.
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Formal file storage, encryption, signed URLs, and virus scanning.
EDOC_STORAGE_PROVIDER=supabase
EDOC_STORAGE_BUCKET=edoc-private
EDOC_SEAL_STORAGE_BUCKET=edoc-seal-vault
# Optional dedicated Supabase Storage project. Leave both unset when Storage
# shares SUPABASE_URL. The publishable key cannot replace this server-only key.
EDOC_STORAGE_SUPABASE_URL=https://your-storage-project-ref.supabase.co
EDOC_STORAGE_SERVICE_ROLE_KEY=replace-with-storage-project-server-secret-key
EDOC_STORAGE_SUPABASE_MODE=dedicated-project
# Set only for S3/R2/custom private storage. Supabase derives /storage/v1 from
# EDOC_STORAGE_SUPABASE_URL (or SUPABASE_URL for a same-project setup).
# EDOC_OBJECT_STORAGE_URL=https://your-private-storage-endpoint/storage/v1
EDOC_STORAGE_ACCESS_MODE=server-signed-url
EDOC_SIGNED_URL_TTL_SECONDS=300
EDOC_FILE_ENCRYPTION_ENABLED=true
EDOC_FILE_ENCRYPTION_KEY=replace-with-32-byte-production-secret
EDOC_SCAN_ENGINE=ClamAV-compatible
EDOC_AV_PROVIDER=vercel-sandbox-clamav-v1
# Pinned Vercel Sandbox snapshot containing ClamAV; store the ID in deployment
# environment only. Production Vercel Functions authenticate with automatic
# project-scoped OIDC, so no extra AV API key or public scanner endpoint exists.
EDOC_AV_SANDBOX_SNAPSHOT_ID=snap_replace_with_clamav_snapshot
# Optional. Leave empty when the snapshot belongs to the current Vercel project.
EDOC_AV_SANDBOX_PROJECT_ID=
EDOC_AV_TIMEOUT_SECONDS=120
# Dedicated 32+ byte bearer secret for the operations-only runtime smoke route.
EDOC_AV_SMOKE_SECRET=replace-with-random-32-byte-secret
# Legacy alternative: set EDOC_AV_PROVIDER=edoc-clamav-https-v1 together with
# EDOC_AV_ENDPOINT and a 32+ byte EDOC_AV_API_KEY.
EDOC_AV_ENDPOINT=
EDOC_AV_API_KEY=
# A private tcp:// / clamd:// INSTREAM endpoint remains supported and does not
# use EDOC_AV_API_KEY, but it must never expose unauthenticated clamd publicly.
EDOC_MAX_FILE_SIZE_MB=100
# Seal images use the small authenticated JSON endpoint. Keep this at 3 MiB
# so Base64 expansion remains within the Vercel Function request limit.
EDOC_SEAL_FILE_MAX_SIZE_MB=3
EDOC_ALLOWED_MIME_TYPES=application/pdf,application/xml,text/xml,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/pkcs7-mime,application/octet-stream

# Required when Vercel Cron is enabled in production.
CRON_SECRET=replace-with-random-local-secret

# Notification delivery. Resend uses the same server-side variable names as the official website.
RESEND_API_KEY=replace-with-server-side-resend-key
MAIL_FROM=公文收發電子用印系統 <notifications@suiyuecare.com>
RESEND_CREDENTIAL_EXPIRES_AT=
# Optional legacy SMTP fallback (leave unset when Resend is enabled).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=notify@suiyuecare.com
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=notify@suiyuecare.com
# SMTP_USE_TLS=true
LINE_WEBHOOK_URL=https://line-webhook.example.com/suiyuecare-edoc
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_TARGET_ID=replace-with-line-group-or-user-id
LINE_CREDENTIAL_EXPIRES_AT=2026-12-31
APP_SECRET=replace-with-app-signing-secret
INBOX_SIGNING_KEY_EXPIRES_AT=2026-12-31

# Formal electronic signature / certificate legality services.
EDOC_SIGNING_SECRET=replace-with-hsm-or-kms-derived-signing-secret
EDOC_SIGNATURE_PROVIDER=HSM/KMS/PAdES provider name
EDOC_HSM_PROVIDER=CloudHSM / KMS / 簽章伺服器
EDOC_CERT_TRUST_STORE=organization/natural-person/business-root-ca-bundle
EDOC_TSA_URL=https://tsa.example.com/rfc3161
EDOC_TSA_POLICY_OID=1.2.158.歲悅.電子公文.時間戳
EDOC_OCSP_RESPONDER_URL=https://ocsp.example.com
EDOC_CRL_DISTRIBUTION_URL=https://crl.example.com/root.crl
