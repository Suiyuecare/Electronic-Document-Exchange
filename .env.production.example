# Required in Vercel Production.
EDOC_DEPLOYMENT_ENV=production
EDOC_DB_MODE=supabase
EDOC_PUBLIC_BASE_URL=https://edoc.suiyuecare.com
EDOC_MONITORING_EXPECTED_CRON_MINUTES=1440

# Supabase server-side REST access. Never expose the service role key to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Vercel Cron security. Vercel sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-random-32-char-secret

# SMTP notification delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notify@suiyuecare.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=notify@suiyuecare.com
SMTP_USE_TLS=true

# LINE / messaging webhook for exchange failures and overdue alerts.
LINE_WEBHOOK_URL=https://line-webhook.example.com/suiyuecare-edoc

# External monitoring / error tracking.
MONITORING_WEBHOOK_URL=https://monitoring-webhook.example.com/suiyuecare-edoc
SENTRY_DSN=https://public@sentry.example.com/1
