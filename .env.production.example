# Required in Vercel Production.
EDOC_DEPLOYMENT_ENV=production
EDOC_DB_MODE=supabase
EDOC_LAUNCH_SCOPE=internal_official
# Finance is the only company source. New active Finance companies are mirrored
# automatically without editing Vercel environment variables.
EDOC_LAUNCH_COMPANY_MODE=finance_active
EDOC_LAUNCH_COMPANY_IDS=
EDOC_PDF_EDITOR_V2_COMPANY_MODE=finance_active
EDOC_PDF_EDITOR_V2_COMPANY_IDS=
EDOC_PUBLIC_BASE_URL=https://edoc.suiyuecare.com
EDOC_MONITORING_EXPECTED_CRON_MINUTES=1440
# Isolated disaster-recovery runner; never point this at the production project.
EDOC_RESTORE_DRILL_ENDPOINT=https://restore-runner.example.com/edoc/drills
EDOC_RESTORE_DRILL_TOKEN=replace-with-scoped-restore-runner-token
EDOC_RESTORE_DRILL_TIMEOUT_SECONDS=300
# Optional AI drafting. Configure only with a newly rotated server-side key.
OPENAI_API_KEY=replace-with-rotated-server-side-openai-key
OPENAI_MODEL=gpt-4.1-mini
EDOC_TARGET_GO_LIVE_DATE=2026-07-13
EDOC_ALLOW_INTERNAL_PILOT=true
EDOC_DISABLE_DEMO_ACCOUNTS=true
# Leave unset/false in production. Setting this true reopens demo login.
EDOC_ALLOW_DEMO_ACCOUNTS=false

# Logging Portal SSO. Must match the Portal side
# PORTAL_HANDOFF_SIGNING_SECRET / EDOC_PORTAL_HANDOFF_SECRET.
EDOC_PORTAL_HANDOFF_SECRET=replace-with-shared-portal-handoff-secret
EDOC_PORTAL_HANDOFF_MAX_AGE_SECONDS=600

# Required server-to-server Finance authority snapshot. Never expose these in
# browser code and never reuse SUPABASE_SERVICE_ROLE_KEY as the bridge secret.
EDOC_FINANCE_BRIDGE_URL=https://finance.example.com/functions/v1/edoc-identity-snapshot
EDOC_FINANCE_BRIDGE_SECRET=replace-with-dedicated-finance-bridge-secret
EDOC_FINANCE_BRIDGE_TIMEOUT_SECONDS=3
EDOC_FINANCE_SESSION_REVALIDATE_SECONDS=60

# Electronic official document exchange gateway. Production must remain mock
# until the competent authority provides the formal connection package.
EDOC_EXCHANGE_ENV=sandbox
EDOC_EXCHANGE_PROVIDER=mock
EDOC_EXCHANGE_MAX_RETRIES=3

# Approved shared-project deployment. HR remains in public; eDoc is isolated in
# the edoc schema and uses a non-BYPASSRLS custom secret role. Never use the
# default service_role secret for the eDoc runtime or expose any secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-edoc-backend-custom-secret-key
EDOC_SUPABASE_SCHEMA=edoc
EDOC_SUPABASE_BACKEND_ROLE=edoc_backend

# Formal file storage, encryption, short-lived downloads, and malware scanning.
EDOC_STORAGE_PROVIDER=supabase
EDOC_STORAGE_BUCKET=edoc-private
EDOC_SEAL_STORAGE_BUCKET=edoc-seal-vault
# Same project and same edoc_backend custom key; Storage RLS limits this role to
# edoc-private and edoc-seal-vault and explicitly excludes hr-documents.
EDOC_STORAGE_SUPABASE_URL=https://your-project-ref.supabase.co
EDOC_STORAGE_SERVICE_ROLE_KEY=replace-with-same-edoc-backend-custom-secret-key
EDOC_STORAGE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-public-key
EDOC_STORAGE_SUPABASE_MODE=shared-project-schema
# Set only for S3/R2/custom private storage. Supabase derives /storage/v1 from
# EDOC_STORAGE_SUPABASE_URL (or SUPABASE_URL for a same-project setup).
# EDOC_OBJECT_STORAGE_URL=https://your-private-storage-endpoint/storage/v1
EDOC_STORAGE_ACCESS_MODE=server-signed-url
EDOC_SIGNED_URL_TTL_SECONDS=300
EDOC_FILE_ENCRYPTION_ENABLED=true
EDOC_FILE_ENCRYPTION_KEY=replace-with-32-byte-production-secret
EDOC_SCAN_ENGINE=ClamAV-compatible
EDOC_AV_PROVIDER=vercel-sandbox-clamav-v1
# Pinned Vercel Sandbox snapshot containing ClamAV. Vercel Functions use the
# automatically injected project-scoped OIDC token; no public AV endpoint or
# separate scanner API key is required.
EDOC_AV_SANDBOX_SNAPSHOT_ID=snap_replace_with_clamav_snapshot
EDOC_AV_SANDBOX_PROJECT_ID=
EDOC_AV_TIMEOUT_SECONDS=120
EDOC_AV_SMOKE_SECRET=replace-with-random-32-byte-secret
# Legacy alternative: edoc-clamav-https-v1 + EDOC_AV_ENDPOINT + a 32+ byte
# EDOC_AV_API_KEY.
EDOC_AV_ENDPOINT=
EDOC_AV_API_KEY=
# A private tcp:// / clamd:// INSTREAM endpoint remains supported and does not
# use EDOC_AV_API_KEY, but it must never expose unauthenticated clamd publicly.
EDOC_MAX_FILE_SIZE_MB=100
# Seal images use the authenticated JSON endpoint and are capped before
# Base64 expansion reaches the Vercel Function request limit.
EDOC_SEAL_FILE_MAX_SIZE_MB=3
EDOC_ALLOWED_MIME_TYPES=application/pdf,application/xml,text/xml,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/pkcs7-mime,application/octet-stream

# Vercel Cron security. Vercel sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-random-32-char-secret
# Application and inbox-signing secret. Keep it separate from CRON_SECRET and
# the file-encryption key so each credential can be rotated independently.
APP_SECRET=replace-with-dedicated-random-32-byte-app-secret

# Resend notification delivery. Keep both values server-side in the eDoc Vercel project.
RESEND_API_KEY=replace-with-server-side-resend-key
MAIL_FROM=公文收發電子用印系統 <notifications@suiyuecare.com>
RESEND_CREDENTIAL_EXPIRES_AT=

# LINE / messaging webhook for exchange failures and overdue alerts.
LINE_WEBHOOK_URL=https://line-webhook.example.com/suiyuecare-edoc
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_TARGET_ID=replace-with-line-group-or-user-id
LINE_CREDENTIAL_EXPIRES_AT=2026-12-31

# External monitoring / error tracking.
MONITORING_WEBHOOK_URL=https://monitoring-webhook.example.com/suiyuecare-edoc
SENTRY_DSN=https://public@sentry.example.com/1

# Formal electronic signature / certificate legality services.
EDOC_SIGNING_SECRET=replace-with-hsm-or-kms-derived-signing-secret
EDOC_SIGNATURE_PROVIDER=HSM/KMS/PAdES provider name
EDOC_HSM_PROVIDER=CloudHSM / KMS / 簽章伺服器
EDOC_CERT_TRUST_STORE=organization/natural-person/business-root-ca-bundle
EDOC_TSA_URL=https://tsa.example.com/rfc3161
EDOC_TSA_POLICY_OID=1.2.158.歲悅.電子公文.時間戳
EDOC_OCSP_RESPONDER_URL=https://ocsp.example.com
EDOC_CRL_DISTRIBUTION_URL=https://crl.example.com/root.crl
